4 — IMAP realtime synchronizer (TypeScript)
src/imapSync.ts — simplified service for multiple accounts, IDLE, 
fetch last 30 days, index into Elasticsearch, categorize:
// src/imapSync.ts
import { ImapFlow } from "imapflow";
import { Client as ESClient } from "@elastic/elasticsearch";
import { categorizeEmail } from "./ai";
import { notifyInterested } from "./notify";
const es = new ESClient({ node: process.env.ES_NODE || 
"http://localhost:9200" });
type ImapAccount = {
 id: string; // account id label
 host: string;
 port: number;
 secure: boolean;
 auth: { user: string; pass: string }
};
export async function startImapForAccount(account: 
ImapAccount) {
 const client = new ImapFlow({
 host: account.host,
 port: account.port,
 secure: account.secure,
 auth: account.auth,
 logger: false
 });
 client.on("error", (err) => console.error("IMAP error:", err));
 await client.connect();
 console.log(`Connected to IMAP for account ${account.id}`);
 // List mailboxes
 for await (let mailbox of client.list()) {
 // open mailbox in read-only mode
 // We'll open INBOX and any interested folders later ondemand
 }
// Fetch recent 30 days emails when starting
 const sinceDate = new Date();
 sinceDate.setDate(sinceDate.getDate() - 30);
 // Example: open INBOX
 await client.mailboxOpen("INBOX");
 // Search for messages since sinceDate
 const searchCriteria = ["SINCE", 
sinceDate.toISOString().split("T")[0]];
 const uids = await client.search(searchCriteria);
 console.log(`Found ${uids.length} messages in ${account.id} 
INBOX`);
 for (const seq of uids.slice(-1000)) { // limit
 const msg = await client.fetchOne(seq, { source: true, 
envelope: true, flags: true, internalDate: true });
 await processAndIndexMessage(msg, account.id, "INBOX");
 }
 // Use IDLE (imapflow will emit 'exists' events)
 client.on("exists", async () => {

// New message arrived; we need to fetch the newest 
messages (UIDLAST or search unseen)
 const unseen = await client.search(["UNSEEN"]);
 for (const uid of unseen) {
 const msg = await client.fetchOne(uid, { source: true, 
envelope: true, flags: true, internalDate: true });
 await processAndIndexMessage(msg, account.id, "INBOX");
 }
 });
}
async function processAndIndexMessage(msg: any, accountId: 
string, folder: string) {
 try {
 const messageId = msg.envelope.messageId || `mid-
${Date.now()}`;
 const subject = msg.envelope.subject || "";
 const from = (msg.envelope.from || []).map((f:any) => 
f.address).join(",");
 const to = (msg.envelope.to || []).map((t:any) => 
t.address).join(",");
const date = msg.internalDate || new Date();
 // Extract plain text body: imapflow source often contains full 
raw; for brevity assume plain text extraction function
 const body = extractPlainText(msg.source) || "";
 // Index raw email
 const doc = {
 messageId,
 account: accountId,
 folder,
 from,
 to,
 subject,
 body,
 date,
 labels: [],
 raw: { envelope: msg.envelope },
 };
 // AI categorization

const category = await categorizeEmail({subject, body, from, 
to});
 doc['category'] = category;
 await es.index({ index: "emails", id: messageId, document: 
doc });
 if (category === "Interested") {
 await notifyInterested(doc);
 }
 console.log(`Indexed ${messageId} (${category})`);
 } catch (err) {
 console.error("processAndIndexMessage error:", err);
 }
}
// Placeholder: implement reliable extraction from raw source
function extractPlainText(rawSource: Buffer | string): string {
 // Use mailparser in real implementation:
 // const parsed = await simpleParser(rawSource)
 // return parsed.text || parsed.html || "";
 return rawSource.toString().slice(0, 1000);
}
Notes:
In production use mailparser (npm i mailparser) to parse MIME 
and get text and attachments.
Use proper UID/messageId dedup to avoid re-indexing

5 — AI Categorization (example using OpenAI chat completions)
src/ai.ts
// src/ai.ts
import axios from "axios";
import dotenv from "dotenv";
dotenv.config();
const OPENAI_KEY = process.env.OPENAI_API_KEY!;
// Keep prompts concise & deterministic. Could also fine-tune 
or build a small classifier on top of embeddings.
export async function categorizeEmail({subject, body, from, to}: 
{subject:string, body:string, from:string, to:string}) {
 const system = `You are an email classifier. Choose one label 
exactly from: Interested, Meeting Booked, Not Interested, 

Spam, Out of Office. Base on subject & body. Provide only the 
label.`;
 const user = `Subject: ${subject}\n\nBody: ${body.slice(0, 
3000)}`;
 const resp = await 
axios.post("https://api.openai.com/v1/chat/completions", {
 model: "gpt-4o-mini", // or gpt-4o or gpt-4 or as available
 messages: [
 {role: "system", content: system},
 {role: "user", content: user}
 ],
 max_tokens: 16,
 temperature: 0
 }, {
 headers: { Authorization: `Bearer ${OPENAI_KEY}` }
 });
 const label = resp.data.choices?.[0]?.message?.content?.trim();
 const normalized = normalizeLabel(label);
 return normalized;
}
function normalizeLabel(out: string | undefined) {
 if (!out) return "Not Interested";
 const o = out.toLowerCase();
 if (o.includes("interested")) return "Interested";
 if (o.includes("meeting")) return "Meeting Booked";
 if (o.includes("spam")) return "Spam";
 if (o.includes("out of office") || o.includes("out-of-office") || 
o.includes("ooo")) return "Out of Office";
 return "Not Interested";
}
If you cannot use OpenAI, replace with a local model or a 
simple rules-based classifier as fallback.

6 — Slack & Webhook.site integration
src/notify.ts
import { IncomingWebhook } from "@slack/webhook";
import axios from "axios";

const slackUrl = process.env.SLACK_WEBHOOK_URL; // set this 
in env
const webhookTarget = 
process.env.INTERESTED_WEBHOOK_URL || 
"https://webhook.site/your-unique-url";
export async function notifyInterested(emailDoc: any) {
 try {
 if (slackUrl) {
 const webhook = new IncomingWebhook(slackUrl);
 await webhook.send({
 text: `*New Interested Email*\nFrom: 
${emailDoc.from}\nSubject: ${emailDoc.subject}\nAccount: 
${emailDoc.account}`,
 blocks: [
 { type: "section", text: { type: "mrkdwn", text: `*New 
Interested Email* \n*From:* ${emailDoc.from}\n*Subject:* 
${emailDoc.subject}\n*Account:* ${emailDoc.account}` } }
 ]
 });
 }

// Trigger external webhook (webhook.site)
 await axios.post(webhookTarget, { event: "interested_email", 
email: emailDoc });
 } catch (err) {
 console.error("notifyInterested error:", err);
 }
}
For Slack, create an Incoming Webhook in your Slack workspace 
and set SLACK_WEBHOOK_URL.
For webhook.site, paste your unique URL into 
INTERESTED_WEBHOOK_URL (good for demo).

7 — REST API for Postman / Frontend
Use Express to expose endpoints:
src/server.ts
import express from "express";
import bodyParser from "body-parser";
import cors from "cors";
import { Client as ESClient } from "@elastic/elasticsearch";
import dotenv from "dotenv";
dotenv.config();
const es = new ESClient({ node: process.env.ES_NODE || 
"http://localhost:9200" });
const app = express();
app.use(cors());
app.use(bodyParser.json());
app.get("/health", (req, res) => res.json({ ok: true }));
// Search emails (Elasticsearch)
app.post("/search", async (req, res) => {
 const { q, account, folder, category, from, size = 20, page = 0 } 
= req.body;
 const must:any[] = [];
 if (q) {
 must.push({
 multi_match: { query: q, fields: 
["subject^3","body","from","to"] }
 });
 }
 if (account) must.push({ term: { account } });
 if (folder) must.push({ term: { folder } });
 if (category) must.push({ term: { category } });
 if (from) must.push({ match: { from } });
 const body:any = { query: { bool: { must: 
must.length?must:[{ match_all: {} }] } }, sort: [{ date: { order: 
"desc" }}], from: page*size, size };
 const resp = await es.search({ index: "emails", body });
 const hits = resp.hits.hits.map(h => ({ id: h._id, ...h._source }));
 res.json({ total: resp.hits.total, hits });
});
// Get email by id
app.get("/emails/:id", async (req, res) => {
 const { id } = req.params;
 const resp = await es.get({ index: "emails", id });
 res.json(resp._source);
});
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log("Server running on", PORT));
Postman endpoints to demo:
GET /health → returns { ok: true }.
POST /search body: { "q": "pricing", "account": "acct1", 
"folder":"INBOX", "size":10 } → returns hits.
GET /emails/:id → returns full stored email.
Show these in Postman with environment variables: ES_NODE, 
API_BASE.

